# Supabase (required — get these from your Supabase project settings)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth dashboard checklist:
# - Google is the only sign-in method: enable the Google provider.
# - Add http://localhost:3000/auth/callback (and any other local dev port you
#   use) and https://<your-domain>/auth/callback to Redirect URLs. Exact
#   addresses only: no * in the host (see CLAUDE.md, "Supabase redirect rules").

# Supabase service role (SERVER-ONLY — never expose to client)
# Used by /api/account (deleting an account) and, locally, by
# scripts/seed-test-user.mjs and the Playwright tests' seeded account.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Upstash Redis (required for production rate limiting)
# Get these from your Upstash console
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Vercel KV (alternative to Upstash — Vercel's managed Redis)
# Uncomment if using Vercel KV instead of Upstash
# KV_REST_API_URL=https://your-vercel-kv.kv.vercel-inc.com
# KV_REST_API_TOKEN=your-token

# Sentry (public DSN - get from Settings -> Projects -> Client Keys (DSN))
NEXT_PUBLIC_SENTRY_DSN=https://<public-key>@o<org-id>.ingest.sentry.io/<project-id>
